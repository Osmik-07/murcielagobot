# Скопируй в .env и заполни. Реальных значений здесь быть не должно.
# Пустое значение = «не задано», подставится дефолт из bot/config.py.

# ---------------------------------------------------------------- Telegram
# Токен бота от @BotFather
BOT_TOKEN=
# Чат для алертов о деньгах: провал фулфилмента, переплата, низкий баланс.
# Для супергруппы/канала id отрицательный. Пусто = алерты никуда не уходят.
ADMIN_CHAT_ID=

# ------------------------------------------------------- TON / Fragment кошелёк
# 24 слова через пробел, в кавычках. Главный секрет: из него берутся
# и cookies Fragment, и подпись исходящих транзакций.
FRAGMENT_WALLET_SEED=
# Адрес этого же кошелька — для сверки с get_wallet() и для ссылок на оплату
FRAGMENT_WALLET_ADDRESS=
# Версия кошелька: V5R1 или V4R2
FRAGMENT_WALLET_VERSION=V5R1
# Провайдер TON API: tonapi или toncenter
FRAGMENT_API_PROVIDER=tonapi
# Таймаут запросов к Fragment, секунды
FRAGMENT_TIMEOUT_SECONDS=30.0
# Через сколько минут считать cookies Fragment протухшими и переавторизоваться
FRAGMENT_COOKIE_TTL_MINUTES=30
# Порог алерта «мало денег на кошельке». Ниже — заказы начнут падать
# на фулфилменте. Газовый минимум 0.01 TON, порог держи заметно выше.
LOW_BALANCE_ALERT_TON=2
LOW_BALANCE_ALERT_USDT=10

# -------------------------------------------------------------- TonConsole
# TonAPI -> API Keys -> Unlimited key (уходит в FragmentClient)
TONCONSOLE_API_KEY=
# Токен раздела Payment Tracker (создание инвойсов и проверка статуса)
PAYMENT_TRACKER_TOKEN=
# Базовый URL API TonConsole
PAYMENT_TRACKER_BASE_URL=https://tonconsole.com/api/v1
# Таймаут запросов к трекеру, секунды
PAYMENT_TRACKER_TIMEOUT_SECONDS=10.0

# ----------------------------------------------------------------- Mini App
# Публичный https-адрес Mini App без хвостового слэша, например
# https://murcielagonebot.ru/app. Пусто — кнопки покупки в боте не показываются.
MINIAPP_URL=

# ---------------------------------------------------------- Вебхук трекера
# Публичный https-адрес сервиса без хвостового слэша, например https://pay.example.com
# Пусто = вебхук выключен, остаются кнопка «проверить оплату» и джоб-сверка.
WEBHOOK_BASE_URL=
# Интерфейс и порт, которые слушает наш http-сервер
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Неугадываемый сегмент пути вебхука, минимум 16 символов [A-Za-z0-9_-].
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Обязателен, если задан WEBHOOK_BASE_URL.
WEBHOOK_SECRET_PATH=
# Необязательная вторая проверка: общий секрет в заголовке запроса
WEBHOOK_SECRET_HEADER=X-Webhook-Secret
WEBHOOK_SECRET_TOKEN=

# --------------------------------------------------------------------- БД
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fragmentbot
# Redis для FSM aiogram. Пусто = MemoryStorage (состояние теряется
# при рестарте, годится только для одного процесса).
REDIS_URL=

# ------------------------------------------------------- Бизнес-параметры
# Сколько минут живёт неоплаченный заказ (он же life_time инвойса)
ORDER_TTL_MINUTES=25
# Наценка сверху цены Fragment, проценты
MARGIN_PERCENT=5.0
# Границы количества Stars в одном заказе (лимиты Fragment: 50..10000000)
STARS_MIN_AMOUNT=50
STARS_MAX_AMOUNT=100000
# Как часто сверять оплаты с трекером — страховка на случай потерянного вебхука, секунды
RECONCILE_INTERVAL_SECONDS=60
# Как часто протухать неоплаченные заказы, секунды
EXPIRE_INTERVAL_SECONDS=300
